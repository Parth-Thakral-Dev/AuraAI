# ====================================================================
# AURA AI PLATFORM - ENVIRONMENT CONFIGURATION
# ====================================================================

# Neural Engine API Key
AURA_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here

# Default Neural Model Tier (aura-3.8-flash, aura-4-pro, aura-3.5-lite)
AURA_MODEL=aura-3.8-flash

# Backend Server Port
PORT=3001

# Supabase PostgreSQL Configuration (Optional: fallback local persistent DB used if not set)
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
